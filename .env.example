# Togisumasu settings. Copy this file to .env and edit it. Never commit .env itself.
# Everything here is optional; the defaults work for local use.

# Server
PORT=3000
# DATA_DIR=./data
# SESSION_DAYS=30
# COOKIE_SECURE=auto
# TRUST_PROXY=false
ALLOW_REGISTRATION=true

# Bootstrap an admin. This account gets the admin role when it registers,
# or is promoted on the next startup if it already exists. Comma-separated.
# ADMIN_EMAIL=you@example.com

# Question bank
# QUESTION_SEED_PER_SKILL=8

# Production compose options (see DEPLOY.md)
# DOMAIN=gym.example.com
# TUNNEL_TOKEN=

# Optional AI tutor. Leave LLM_PROVIDER empty to turn it off.
# LLM_PROVIDER=deepseek
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_DAILY_LIMIT=30
# LLM_MAX_TOKENS=700
# LLM_TIMEOUT_MS=30000

# Public URL used in email links (no trailing slash).
# APP_BASE_URL=http://localhost:3000
# Optional path prefix if the app is served at a subpath, e.g. /apps/samasu
# BASE_PATH=

# Transactional email via Resend. Leave RESEND_API_KEY empty to log emails
# to the console instead of sending them (useful in local development).
# Until your own domain is verified, use the test sender below. It only
# delivers to the Resend account owner's email address.
# EMAIL_FROM=Togisumasu <onboarding@resend.dev>
# RESEND_API_KEY=
# Optional Resend template IDs or aliases. If unset, the server sends
# the built-in HTML and text for each message.
# RESEND_TEMPLATE_VERIFY=togisumasu-verify
# RESEND_TEMPLATE_RESET=togisumasu-reset
# RESEND_TEMPLATE_WELCOME=togisumasu-welcome
