# Togisumasu settings. Copy this file to .env and edit it. Never commit .env itself.
# Everything here is optional; the defaults work for local use.

# Server
PORT=3000
# DATA_DIR=./data
# SESSION_DAYS=30
# COOKIE_SECURE=auto
# TRUST_PROXY=false
ALLOW_REGISTRATION=true

# Bootstrap an admin. This account gets the admin role when it registers,
# or is promoted on the next startup if it already exists. Comma-separated.
# ADMIN_EMAIL=you@example.com

# Question bank
# QUESTION_SEED_PER_SKILL=8

# Production compose options (see DEPLOY.md)
# DOMAIN=gym.example.com
# TUNNEL_TOKEN=

# Optional AI tutor. Leave LLM_PROVIDER empty to turn it off.
# LLM_PROVIDER=deepseek
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_DAILY_LIMIT=30
# LLM_MAX_TOKENS=700
# LLM_TIMEOUT_MS=30000
