{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mohlodi.local/schema/paper.schema.json",
  "title": "Exam paper",
  "description": "One NSC exam paper: metadata, its question tree (flat list of nodes linked by parent) and its figures. One file per paper in papers/<id>.json.",
  "type": "object",
  "required": ["id", "subject", "exam", "grade", "year", "session", "paper", "language", "total_marks", "source", "questions", "figures"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^\\d{4}-(nov|jun|mar)-p[1-3]$", "description": "e.g. 2025-nov-p1"},
    "subject": {"enum": ["mathematics", "physical-sciences"]},
    "exam": {"const": "NSC"},
    "grade": {"const": 12},
    "year": {"type": "integer", "minimum": 2008},
    "session": {"enum": ["november", "may-june", "feb-march"]},
    "paper": {"type": "integer", "minimum": 1, "maximum": 3},
    "language": {"const": "eng"},
    "total_marks": {"type": "integer"},
    "duration_minutes": {"type": "integer"},
    "source": {
      "type": "object",
      "required": ["pdf"],
      "properties": {
        "pdf": {"type": "string"},
        "pdf_pages": {"type": "integer"},
        "first_printed_page": {"type": "integer", "description": "Printed page number of PDF page 1 (DBE scans often start at 3)."},
        "url": {"type": "string"},
        "original_name": {"type": "string"},
        "sha256": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "extraction": {"type": "object"},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "question.schema.json"}},
    "figures": {"type": "array", "items": {"$ref": "figure.schema.json"}}
  }
}
