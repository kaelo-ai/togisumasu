{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mohlodi.local/schema/memo.schema.json",
  "title": "Paper marking guidelines",
  "description": "Official NSC marking guidelines for one paper, stored as memos/<paper_id>.json. Each leaf question has a matching part with the final answer and the memo's mark-by-mark allocation.",
  "type": "object",
  "required": ["id", "paper_id", "source", "extraction", "notes", "parts"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^\\d{4}-(nov|jun|mar)-p[1-3]$", "description": "Same as paper_id, e.g. 2025-nov-p1"},
    "paper_id": {"type": "string", "pattern": "^\\d{4}-(nov|jun|mar)-p[1-3]$"},
    "source": {
      "type": "object",
      "required": ["pdf"],
      "additionalProperties": false,
      "properties": {
        "pdf": {"type": "string", "description": "Path relative to the bank root, usually under sources/maths/"},
        "pdf_pages": {"type": "integer", "minimum": 1},
        "url": {"type": "string"},
        "original_name": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "note": {"type": "string"}
      }
    },
    "extraction": {
      "type": "object",
      "required": ["method", "date", "schema_version"],
      "additionalProperties": false,
      "properties": {
        "method": {"type": "string"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "schema_version": {"type": "integer", "minimum": 1}
      }
    },
    "notes": {"type": ["string", "null"], "description": "Paper-level examiner notes from the front of the memo (English only)."},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/part"}
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["marks", "mark_type", "description"],
      "additionalProperties": false,
      "properties": {
        "marks": {"type": "integer", "minimum": 1, "description": "Marks for this tick; 2 if the memo prints a double tick."},
        "mark_type": {
          "type": ["string", "null"],
          "description": "Mark-type code only when the memo itself prints one (A, CA, M, S, R, C, J, AO, …). Null if the memo gives only a description."
        },
        "description": {"type": "string", "minLength": 1, "description": "Short English description from the memo's tick label. Markdown + KaTeX ($...$)."}
      }
    },
    "method": {
      "type": "object",
      "required": ["answer_md", "working_md", "steps"],
      "additionalProperties": false,
      "properties": {
        "label": {"type": ["string", "null"], "description": "Label used by the memo, e.g. OR, when this is an alternative method."},
        "answer_md": {"type": "string", "description": "Final answer in Markdown + KaTeX. For show-that/proof/sketch, the given result or a short description of what is awarded."},
        "working_md": {"type": "string", "description": "The worked solution as printed (English only). Markdown + KaTeX."},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "notes": {"type": ["string", "null"], "description": "Examiner notes that apply to this method (answer only, penalties, rejections, …)."}
      }
    },
    "part": {
      "type": "object",
      "required": ["id", "question_id", "number", "marks", "answer_md", "working_md", "steps", "alternatives", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^\\d{4}-(nov|jun|mar)-p[1-3]-\\d+(\\.\\d+)*$", "description": "Same as the leaf question id; this is the value stored in question.memo_ref."},
        "question_id": {"type": "string", "pattern": "^\\d{4}-(nov|jun|mar)-p[1-3]-\\d+(\\.\\d+)*$"},
        "number": {"type": "string", "pattern": "^\\d+(\\.\\d+)*$"},
        "marks": {"type": "integer", "minimum": 1},
        "answer_md": {"type": "string"},
        "working_md": {"type": "string"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "alternatives": {
          "type": "array",
          "items": {"$ref": "#/$defs/method"}
        },
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
